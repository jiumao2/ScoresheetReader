SCORESHEET_TEMPLATE_PATH=C:/path/to/scoresheet_template.pdf
SCORESHEET_DATA_DIR=C:/path/to/scoresheet-reader-data
SCORESHEET_FONT_PATH=C:/Windows/Fonts/msyh.ttf
SCORESHEET_MASTER_DATA_DIR=C:/path/to/private-master-data
# Optional alternative to SCORESHEET_MASTER_DATA_DIR; leave empty for private data.
SCORESHEET_MASTER_FIXTURE_PATH=
SCORESHEET_COMPETITION_NAME=2026北大杯
SCORESHEET_RECOGNITION_MODE=qwen
QWEN_API_KEY=replace-with-your-private-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_REASONING_EFFORT=xhigh
SCORESHEET_RECOGNITION_UPSCALE_TARGET_PIXELS=8000000
SCORESHEET_RECOGNITION_TIMEOUT_SECONDS=180
SCORESHEET_RECOGNITION_CONCURRENCY=2
